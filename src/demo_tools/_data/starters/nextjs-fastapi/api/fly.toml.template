app = "__APP_API__"
primary_region = "lhr"

[build]

# Internal-only — no public http_service. The api app has no public IP, so
# this services block only governs how .internal traffic routes to the
# internal_port. The empty handlers list keeps Fly's proxy from exposing
# port 8000 externally even if a public IP were ever attached.
[[services]]
  internal_port = 8000
  protocol = "tcp"
  # Required. Fly's default when auto_stop_machines is absent is "off", which
  # means the machine never stops and bills 24/7 for the life of the app. The
  # web app's .internal requests wake it back up on demand.
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0

  [[services.ports]]
    port = 8000
    handlers = []

[[vm]]
  size = "shared-cpu-1x"
  memory = "256mb"

[mounts]
  source = "__VOLUME_NAME__"
  destination = "/data"
  initial_size = "1gb"
