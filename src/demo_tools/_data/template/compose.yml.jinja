{%- if stack == "nextjs-fastapi" %}
services:
  web:
    build: ./web
    ports:
      - "3000:3000"
    environment:
      API_URL: http://api:8000
    depends_on:
      - api
  api:
    build: ./api
    ports:
      - "8000:8000"
    volumes:
      - api_data:/data

volumes:
  api_data:
{%- else %}
services:
  app:
    build: .
    ports:
      # host:container. host_port defaults to internal_port and only differs when
      # another local app already owns that port — the local target's Tailscale
      # serve points at the HOST side (HOST_PORT in infra/local/_lib.sh).
      - "{{ host_port }}:{{ internal_port }}"
{% if stateful %}    volumes:
      - app_data:/data
{% endif %}
{% if stateful %}
volumes:
  app_data:
{% endif %}
{%- endif %}
