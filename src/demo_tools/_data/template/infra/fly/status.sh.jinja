set -euo pipefail
APP="{{ name }}"
HOSTNAMES=({% for h in hostnames %}"{{ h }}"{{ " " if not loop.last }}{% endfor %})
{% if stack == "nextjs-fastapi" -%}
echo "== ${APP}-web =="
fly status --app "${APP}-web"
echo
echo "== ${APP}-api =="
fly status --app "${APP}-api"
echo
echo "URLs:"
echo "  https://${APP}-web.fly.dev"
{%- else -%}
fly status --app "$APP"
echo
echo "URLs:"
echo "  https://${APP}.fly.dev"
{%- endif %}
for host in ${HOSTNAMES[@]+"${HOSTNAMES[@]}"}; do
    echo "  https://${host}"
done
